{
  "appId": "com.alexandruchiscari.openshift-gui",
  "productName": "OpenShift GUI",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "mac": {
    "icon": "build/icon.icns",
    "target": [
      {
        "target": "dir",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ],
    "category": "public.app-category.developer-tools",
    "identity": null
  },
  "linux": {
    "icon": "build/icon.png",
    "target": [
      {
        "target": "tar.gz",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "Development"
  },
  "win": {
    "icon": "build/icon.png",
    "target": [
      {
        "target": "portable",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "zip",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      }
    ]
  }
}
