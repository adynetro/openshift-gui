{
  "name": "openshift-gui",
  "version": "0.1.0",
  "description": "Modern Graphical Desktop GUI & CLI for OpenShift and Kubernetes with Helm & SemVer ImageStream Cleanup",
  "bin": {
    "openshift-gui": "./bin/openshift-gui.js",
    "oc-gui": "./bin/openshift-gui.js"
  },
  "main": "dist/main/index.cjs",
  "type": "module",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "gui": "node scripts/build-electron.js && electron .",
    "build:gui": "node scripts/build-electron.js",
    "pack:app": "node scripts/build-electron.js && electron-builder --mac --dir",
    "pack:dmg": "node scripts/build-electron.js && electron-builder --mac dmg",
    "pack:zip": "node scripts/build-electron.js && electron-builder --mac zip",
    "watch": "tsc --watch",
    "start": "npm run gui",
    "cli": "node bin/openshift-gui.js",
    "dev": "tsx src/index.tsx",
    "test": "node --test dist/**/*.test.js",
    "release": "node scripts/build-release.js",
    "build:mac": "node scripts/build-mac-binary.js"
  },
  "keywords": [
    "openshift",
    "kubernetes",
    "gui",
    "desktop",
    "electron",
    "cli",
    "tui",
    "helm",
    "imagestream",
    "semver"
  ],
  "author": "Alexandru Chiscari",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "clsx": "^2.1.1",
    "commander": "^13.1.0",
    "figures": "^6.1.0",
    "fuse.js": "^7.1.0",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.7.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.1",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/semver": "^7.5.8",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^4.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
